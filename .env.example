VITE_API_URL=https://jsonplaceholder.typicode.com/photos
VITE_API_RETRIES=3
VITE_API_RETRY_DELAY=1000
# Таймаут запроса, мс: без него «зависшее» соединение ждёт бесконечно
# VITE_API_TIMEOUT_MS=15000

# Размер страницы: определяет гранулярность прогресса (500 из 5000 — шаг 10%)
VITE_API_PAGE_SIZE=500
# Сколько страниц грузим одновременно
VITE_API_MAX_CONCURRENCY=3
# Fallback, если сервер не отдаёт X-Total-Count (обычно не нужен)
# VITE_API_TOTAL_PHOTOS=5000

# Автозагрузка при открытии: по умолчанию off — ждём кнопку «Загрузить данные».
# Включить: on / true / 1
# VITE_PHOTOS_AUTOLOAD=on

# Искусственная задержка перед каждым запросом, мс: нужна только для демонстрации
# прогресса и проверки отмены. По умолчанию 300, 0 — выключить
# VITE_API_ARTIFICIAL_DELAY_MS=300
